{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean -f *)",
      "Bash(git clean -d *)",
      "Bash(git branch -D *)",
      "Read(.env*)",
      "Edit(.env*)",
      "Bash(cat .env*)",
      "Bash(*password*)",
      "Bash(*secret*)"
    ]
  }
}
