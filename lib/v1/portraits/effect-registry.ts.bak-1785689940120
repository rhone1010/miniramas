export type SiloId =
  | 'earth_ore'
  | 'artists_gallery'
  | 'light_glass'
  | 'myth_legend'
  | 'far_future'
  | 'another_age'
  | 'living_world'
  | 'handmade'

/** 'live'     — body + avoid are in the engine NOW; safe to offer and spend on.
 *  'authored' — text exists (see the CENG carryover) but is NOT yet entered
 *               into the engine. The gate will refuse it. Do not offer.
 *  'todo'     — not written.                                                  */
export type BodyStatus = 'live' | 'authored' | 'todo'

/** Likeness gate band. Thresholds are NOT set — pull the bench fidelity-score
 *  distribution and set them from real data before this is wired.             */
export type LikenessFloor = 'strict' | 'relaxed' | 'bypass'

export interface Silo {
  id:    SiloId
  label: string
  /** Curator's line on entering the room. CUI draft register; CENG to finalize. */
  line:  string
}

export interface Effect {
  id:       string          // snake_case. Matches the engine preset/effect id EXACTLY.
  label:    string          // customer-facing. Plain unicode — no HTML entities.
  category: SiloId

  mode:       'material' | 'costume'
  monolithic: boolean       // true → takes HUE_LOCK (one substance, one hue family)

  body:   BodyStatus
  refs:   number            // ref plates shot and approved, 0-3
  /** Per-effect framing override. Absent = 'bust'.                            */
  framing?:      'bust' | 'signature' | 'statuesque'
  likenessFloor: LikenessFloor
  /** Effect carries its own light source; drop the STAGING paragraph.         */
  skipStaging?:  boolean
  /** Effect owns its own composition; skip the universal framing block.       */
  skipUniversal?: boolean
  /** Gendered ref plates (2_man / 2_woman / 2_neutral) rather than neutral.
   *  UNDER REVIEW — a deliberately diverse neutral set may remove the need.   */
  genderedRefs?: boolean

  /** Not customer-facing. Carried so the lanes stop re-deriving it. */
  note?: string
}

