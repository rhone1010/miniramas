// ── DERIVED HELPERS ──────────────────────────────────────────────────────────

/** Safe to offer and spend credits on. Replaces CUI's hand-maintained
 *  NO_ENGINE list, which went stale the moment a body landed. */
export const isOfferable = (e: Effect): boolean => e.body === 'live'

export const effectsBySilo = (silo: SiloId): Effect[] =>
  EFFECTS.filter(e => e.category === silo)

export const offerableBySilo = (silo: SiloId): Effect[] =>
  effectsBySilo(silo).filter(isOfferable)

export const byId = (id: string): Effect | undefined =>
  EFFECTS.find(e => e.id === id)
